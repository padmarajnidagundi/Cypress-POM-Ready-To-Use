{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "types": ["cypress", "node"],
    "allowJs": true,
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@pageObjects/*": ["./cypress/pageObjects/*"],
      "@support/*": ["./cypress/support/*"]
    }
  },
  "include": ["**/*.ts", "**/*.js"]
}
